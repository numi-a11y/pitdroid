<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Main Brand Colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Force Global Dark Mode Background -->
        <item name="android:windowBackground">@color/charcoal_bg</item>

        <!-- Default Text Colors -->
        <item name="android:textColorPrimary">@color/text_light</item>
        <item name="android:textColorSecondary">@color/text_muted</item>

        <!-- Make standard progress bars and switches use Neon Green -->
        <item name="colorControlActivated">@color/neon_green</item>
    </style>
</resources>