<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1A1A1D"
        android:padding="16dp">
    <!-- A deep, sleek charcoal background makes the colors pop -->

    <!-- Pit Temp -->
    <TextView
            android:id="@+id/pitTempLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PIT TEMP"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#8E8E93"
            android:letterSpacing="0.1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"/>

    <!-- Neon Orange with a glow effect -->
    <TextView
            android:id="@+id/pitTempVal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="250°"
            android:textSize="85sp"
            android:textStyle="bold"
            android:textColor="#FF9800"
            android:shadowColor="#66FF9800"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20"
            app:layout_constraintTop_toBottomOf="@id/pitTempLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Meat Temp -->
    <TextView
            android:id="@+id/meatTempLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEAT TEMP (PROBE 1)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#8E8E93"
            android:letterSpacing="0.1"
            app:layout_constraintTop_toBottomOf="@id/pitTempVal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"/>

    <!-- Neon Red with a glow effect -->
    <TextView
            android:id="@+id/meatTempVal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="195°"
            android:textSize="85sp"
            android:textStyle="bold"
            android:textColor="#FF5252"
            android:shadowColor="#66FF5252"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20"
            app:layout_constraintTop_toBottomOf="@id/meatTempLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Tenderness Meter -->
    <TextView
            android:id="@+id/tendernessLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TENDERNESS SCORE"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#8E8E93"
            android:letterSpacing="0.1"
            app:layout_constraintTop_toBottomOf="@id/meatTempVal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="48dp"/>

    <!-- Neon Green Progress Bar -->
    <ProgressBar
            android:id="@+id/tendernessProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:max="1000"
            tools:progress="652"
            android:progressTint="#00E676"
            android:progressBackgroundTint="#333333"
            app:layout_constraintTop_toBottomOf="@id/tendernessLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"/>

    <!-- Neon Green Text with Glow -->
    <TextView
            android:id="@+id/tendernessVal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="65.2%"
            android:textSize="55sp"
            android:textStyle="bold"
            android:textColor="#00E676"
            android:shadowColor="#6600E676"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20"
            app:layout_constraintTop_toBottomOf="@id/tendernessProgress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

    <!-- Controls at the bottom -->
    <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/holdingSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Holding Phase   "
            android:textColor="#E0E0E0"
            android:textSize="18sp"
            android:textStyle="bold"
            app:thumbTint="#FF9800"
            app:trackTint="#757575"
            app:layout_constraintBottom_toTopOf="@id/buttonContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="24dp"/>

    <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="32dp">

        <Button
                android:id="@+id/btnResetCook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESET COOK"
                android:backgroundTint="@color/neon_red"
                android:textColor="@color/text_light"
                android:layout_marginEnd="16dp"/>

        <Button
                android:id="@+id/btnRecalculate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECALCULATE"
                android:backgroundTint="@color/neon_blue"
                android:textColor="@color/text_light" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>